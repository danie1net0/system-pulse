{
  "name": "system-pulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "build": "npm run typecheck && node scripts/build.ts",
    "pack": "npm run build && node --input-type=module -e \"import {pack} from './scripts/pack.ts'; console.log('Pacote criado: ' + pack(process.cwd()));\"",
    "test": "npm run typecheck && node --import ./tests/support/gnome-loader.ts --test 'tests/**/*.test.ts'",
    "check": "npm run coverage && npm run build",
    "watch": "npm run build && tsc --watch",
    "setup": "node install.ts",
    "coverage": "npm run typecheck && node --import ./tests/support/gnome-loader.ts --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-include='scripts/**/*.ts' --test-coverage-include='install.ts' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 'tests/**/*.test.ts'"
  },
  "devDependencies": {
    "@girs/gjs": "5.5.0",
    "@girs/gnome-shell": "50.0.4",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
