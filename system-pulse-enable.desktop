[Desktop Entry]
Type=Application
Name=System Pulse — Adicionar à barra
Name[en]=System Pulse — Add to bar
Comment=Ativa o monitor de CPU, RAM e swap na barra superior do GNOME
Comment[en]=Shows the CPU, RAM and swap monitor on the GNOME top bar
Exec=gnome-extensions enable system-pulse@danie1net0.gitlab.io
Icon=system-pulse
Terminal=false
StartupNotify=false
Categories=System;Monitor;
Keywords=RAM;CPU;swap;memória;monitor;widget;
Keywords[en]=RAM;CPU;swap;memory;monitor;widget;
